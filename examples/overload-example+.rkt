#lang reader SRFI-110

(module overload-example racket
  
(require Scheme+)
ANNOTATION-ON

(define (dot-product v1 v2) ; v1 * v2 -> v , v1[] : fixnum ,v2[] : fixnum
  (type #(fixnum?) v1 v2) ; vectors of fixnums (or with the bracket notation : (type vector? v1 v2) (type fixnum? {v1[]} {v2[]}))
  (apply + (vector->list (vector-map * v1 v2)))) ; code generated by the annotation parser : (apply fx+ (vector->list (vector-map fx* v1 v2)))

;(type [(fixnum?) procedure? (#(fixnum?) #(fixnum?))] dot-product)
  
  #| essai comment multi line
|#

  

(overload-operator * (fixnum?) dot-product (vector? vector?))
 
(define (mult-scalar-vect x v)
  (define (mult-scalar-coord c)
    (type fixnum? x c)
    {x * c})
  (vector-map mult-scalar-coord v))
 

(overload-operator * (#(fixnum?)) mult-scalar-vect (fixnum? vector?)) ; return type for the parser : vector of fixnums ; the predicates stay real predicates (called at runtime)
  

